{
  "git.autofetch": true,
  "git.autofetchPeriod": 90,
  "search.exclude": {
    "**/target": true
  },
  "files.watcherExclude": {
    "**/target/**": true
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--all-targets", "--", "-D", "warnings"],
  "window.title": "${activeRepositoryBranchName}",
  "coverage-gutters.coverageFileNames": ["lcov.info"],
  "git.postCommitCommand": "push",

  // Python / basedpyright configuration for multi-root workspace
  "basedpyright.analysis.extraPaths": [
    "${workspaceFolder}/python",
    "${workspaceFolder}/infoflow-python-plugin/src",
    "${workspaceFolder}/infoflow-python-plugin/scripts"
  ],
  "basedpyright.analysis.ignore": [
    "**/target",
    "**/.venv"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/python",
    "${workspaceFolder}/infoflow-python-plugin/src",
    "${workspaceFolder}/infoflow-python-plugin/scripts"
  ],

  // Disable Python import sorting
  "[python]": {
    "editor.formatOnSave": false
  }
}
